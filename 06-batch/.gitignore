# --- Data Files ---
# Never push raw or processed data to GitHub
data/
*.csv
*.parquet
*.json
*.gz
*.zip

# --- Credentials & Secrets ---
# Crucial: Protect your GCP Service Account keys
*.json
credentials/
.env
.secrets/
auth/

# --- Spark & Hadoop ---
# Spark creates these when running locally
.spark-staged/
derby.log
metastore_db/
checkpoint/
# Ignore event logs and temporary scratch space
spark-warehouse/
warehouse/
*.lzo
*.crc

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env/
build/
dist/
*.egg-info/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
# Optional: if you want to keep notebooks but not their output
# (Requires a tool like nbstripout, otherwise leave this commented)
# *.ipynb

# --- Virtual Machines & Local Clusters ---
# If you are running Spark logs or PID files locally
*.pid
*.log
logs/

# --- Operating System ---
.DS_Store
Thumbs.db